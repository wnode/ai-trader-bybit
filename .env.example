# =========================================
# AI TRADER BOT — LLM-Powered Trading
# =========================================

# =========================================
# BYBIT
# =========================================
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here
USE_TESTNET=true
DRY_RUN=true

# =========================================
# TRADING
# =========================================
# Lista de simbolos (separados por virgula). Cada simbolo opera independente.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=15
CHECK_INTERVAL=300
LEVERAGE=25
# Risco por trade como fracao do capital (0.0001 = 0.01% para testes, max 0.1 = 10%)
RISK_PER_TRADE=0.0001
# Candles para enviar a LLM (96 = 24h de 15min)
KLINES_TO_SEND=96
# Candles diarios para contexto macro
DAILY_KLINES=30

# =========================================
# INDICADORES TECNICOS
# =========================================
RSI_PERIOD=14
EMA_FAST=9
EMA_MID=21
EMA_SLOW=50
BB_PERIOD=20
BB_STD=2.0
ADX_PERIOD=14
ATR_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VOL_AVG_PERIOD=20

# =========================================
# REGRAS DE TRADING
# =========================================
# SL minimo e maximo (% do preco de entrada)
SL_MIN_PCT=0.3
SL_MAX_PCT=1.0
# Risk/reward minimo (1.0 = 1:1). Com TP parcial, e o alvo do RUNNER (TP2)
MIN_RR_RATIO=1.0
# Confianca minima da LLM para operar (0.0 a 1.0)
MIN_CONFIDENCE=0.8
# ADX abaixo desse valor = mercado lateral (evitar trades)
ADX_RANGING_THRESHOLD=15

# --- Risco:Retorno alto: TP parcial + runner com breakeven ---
# Liga a estrategia: fecha parte no TP1 e deixa o resto correr ate MIN_RR_RATIO:1
PARTIAL_TP_ENABLED=false
# Alvo do TP1 parcial (deve ser < MIN_RR_RATIO). Ex: 1.5 = 1.5:1
TP1_RR_RATIO=1.5
# Fracao da posicao fechada no TP1 (0.5 = 50%); o resto vira runner
TP1_SIZE_PCT=0.5
# Apos o TP1, move o SL para breakeven (runner sem risco)
BREAKEVEN_AFTER_TP1=true
# Offset do breakeven em % do entry, p/ cobrir taxas (0.05 = 0.05%)
BREAKEVEN_OFFSET_PCT=0.05

# =========================================
# LIDER DE MERCADO (filtro direcional BTC/ETH)
# =========================================
# Veta entradas de alts contra a direcao do BTC (e ETH p/ ecossistema ETH).
# So permite LONG se lider bullish; so SHORT se bearish. CLOSE sempre passa.
# Fail-open: falha de coleta do lider NAO bloqueia trades.
LEADER_FILTER_ENABLED=false
# Alts do ecossistema ETH que exigem confirmacao ADICIONAL de ETH (alem do BTC)
# Ex: LINKUSDT,ARBUSDT,OPUSDT. Vazio = so o BTC filtra.
LEADER_ETH_SYMBOLS=
# Timeframe dos klines dos lideres (default = TIMEFRAME)
LEADER_TIMEFRAME=15
# Se true, lider NEUTRO tambem bloqueia (mais rigoroso). Default: so lider oposto veta
LEADER_BLOCK_ON_NEUTRAL=false
# Simbolos usados como lideres (normalmente nao precisa mudar)
LEADER_BTC_SYMBOL=BTCUSDT
LEADER_ETH_SYMBOL=ETHUSDT
# Modo mecanico (USE_LLM=false): fecha a posicao quando o lider inverte
LEADER_CLOSE_ON_FLIP=true

# =========================================
# MODO DE DECISAO (LLM ou mecanico)
# =========================================
# USE_LLM=true  -> a LLM decide (usa LLM_PROVIDER abaixo)
# USE_LLM=false -> SEM LLM (custo zero): decisao mecanica pela direcao do lider
#   BTC/ETH (flat+bullish->LONG, bearish->SHORT, fecha na virada). Backtest
#   mostrou que essa estrategia so e lucrativa em timeframe alto (ex: TIMEFRAME=240,
#   4h) com TP unico (PARTIAL_TP_ENABLED=false). Requer o lider (BTC/ETH).
USE_LLM=true
# Economia de custo da LLM (so afeta USE_LLM=true):
# Intervalo minimo entre chamadas da LLM por simbolo (min). 0 = todo ciclo.
# Ex: 15 = 1x por vela de 15min (nao reanalisa a mesma vela).
LLM_INTERVAL_MINUTES=0
# Nao chama a LLM enquanto ha posicao aberta (saidas via TP/SL/breakeven). Corta o maior custo.
LLM_SKIP_WHEN_IN_POSITION=false
# HIBRIDO (LLM-como-filtro): a mecanica (lider BTC/ETH + pullback + F&G + regime)
# detecta os setups; a LLM so e chamada NESSES setups p/ aprovar/vetar. Custo baixo
# com muitos simbolos + julgamento da LLM para elevar o WR. So vale com USE_LLM=true.
LLM_AS_FILTER=false
# Regime macro do setup hibrido: so LONG com BTC>MA(N dias), so SHORT abaixo
HYBRID_REGIME_FILTER=true
REGIME_MA_DAYS=200
# Fear & Greed (contrarian) do setup: bloqueia LONG >=GREED_MAX, SHORT <=FEAR_MIN
FNG_GREED_MAX=80
FNG_FEAR_MIN=20

# =========================================
# LLM PROVIDER
# =========================================
# Provider: anthropic, google, openai, xai
LLM_PROVIDER=google

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI GPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# xAI Grok (https://console.x.ai)
XAI_API_KEY=your_xai_key
XAI_MODEL=grok-3-mini
# Modelo usado quando XAI_SEARCH=true (precisa ser familia grok-4)
XAI_SEARCH_MODEL=grok-4-1-fast-non-reasoning
# Habilitar x_search + web_search (busca noticias/sentimento em tempo real no X e web)
XAI_SEARCH=false
# Cachear resultado do search por N iteracoes (6 = ~30min com CHECK_INTERVAL=300)
XAI_SEARCH_CACHE_ITERATIONS=6
# Monitor de sentimento durante sleep: checa a cada N segundos (0=desligado)
# Se detectar mudanca brusca (urgencia sobe 3+ pontos ou >= 8), forca analise imediata
SENTIMENT_MONITOR_INTERVAL=120

# =========================================
# SENTIMENTO DE MERCADO
# =========================================
# Fear & Greed Index (alternative.me) — funciona com qualquer provider
USE_SENTIMENT=false
# Cache em minutos (API atualiza 1x/dia)
FNG_CACHE_MINUTES=60

# =========================================
# X API v2 STREAM (TEMPO REAL)
# =========================================
# Requer conta developer X (https://developer.x.com) — plano Basic ($100/mês)
X_STREAM_ENABLED=false
X_BEARER_TOKEN=your_x_bearer_token
# Keywords para filtrar tweets (separadas por virgula)
X_STREAM_KEYWORDS=bitcoin,btc,ethereum,eth,solana,sol,crypto,#bitcoin,#btc,#eth
# Urgencia minima para alertar (1-10). 7 = noticias importantes
X_STREAM_URGENCY_THRESHOLD=7
